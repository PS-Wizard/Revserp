FROM golang:1.26-bookworm AS build

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -o /out/worker ./cmd/worker

FROM debian:bookworm-slim

ARG TARGETARCH

WORKDIR /app

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates curl tar \
	&& rm -rf /var/lib/apt/lists/*

RUN case "$TARGETARCH" in \
		amd64) obscura_arch="x86_64" ;; \
		arm64) obscura_arch="aarch64" ;; \
		*) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
	esac \
	&& curl -fsSL -o /tmp/obscura.tar.gz "https://github.com/h4ckf0r0day/obscura/releases/latest/download/obscura-${obscura_arch}-linux.tar.gz" \
	&& tar -xzf /tmp/obscura.tar.gz -C /usr/local/bin obscura \
	&& chmod +x /usr/local/bin/obscura \
	&& rm -f /tmp/obscura.tar.gz

COPY --from=build /out/worker /app/worker
COPY scripts/start-worker.sh /app/start-worker.sh

RUN chmod +x /app/worker /app/start-worker.sh

CMD ["/app/start-worker.sh"]
