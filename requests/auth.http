@supabase_url = https://bxqpoqsaiznfwfmernyv.supabase.co
@supabase_anon_key = YOUR_SUPABASE_ANON_KEY

@email1 = you1@example.com
@password1 = password12345
@email2 = you2@example.com
@password2 = password12345

@access_token1 = PASTE_ACCESS_TOKEN_FOR_EMAIL1_HERE
@access_token2 = PASTE_ACCESS_TOKEN_FOR_EMAIL2_HERE

### Signup user 1
POST {{supabase_url}}/auth/v1/signup
apikey: {{supabase_anon_key}}
Authorization: Bearer {{supabase_anon_key}}
Content-Type: application/json

{
  "email": "{{email1}}",
  "password": "{{password1}}",
  "data": {
    "name": "Test User 1"
  }
}

### Login user 1
POST {{supabase_url}}/auth/v1/token?grant_type=password
apikey: {{supabase_anon_key}}
Authorization: Bearer {{supabase_anon_key}}
Content-Type: application/json

{
  "email": "{{email1}}",
  "password": "{{password1}}"
}

### Signup user 2
POST {{supabase_url}}/auth/v1/signup
apikey: {{supabase_anon_key}}
Authorization: Bearer {{supabase_anon_key}}
Content-Type: application/json

{
  "email": "{{email2}}",
  "password": "{{password2}}",
  "data": {
    "name": "Test User 2"
  }
}

### Login user 2
POST {{supabase_url}}/auth/v1/token?grant_type=password
apikey: {{supabase_anon_key}}
Authorization: Bearer {{supabase_anon_key}}
Content-Type: application/json

{
  "email": "{{email2}}",
  "password": "{{password2}}"
}
