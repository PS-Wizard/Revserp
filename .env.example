# App / API
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://revserp:revserp@localhost:5432/revserp_app?sslmode=disable

# Supabase / Auth
AUTH_PROVIDER=supabase
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_ANON_KEY=your-supabase-anon-key

# Sessions / CORS
SESSION_COOKIE_NAME=revserp_session
SESSION_COOKIE_DOMAIN=
SESSION_TTL=720h
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Worker Stuff
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=2s
CRAWL_PAGE_WORKER_COUNT=4

## Usual Crawl
CRAWL_MAX_RETRIES=3
CRAWL_RETRY_BASE_MS=1000
CRAWL_RETRY_MAX_MS=15000

## Auto Crawl
# Number of concurrent auto-crawl workers polling queued auto crawls
AUTO_CRAWL_CONCURRENCY=1
# How often each worker polls for new auto-crawl tasks
AUTO_CRAWL_POLL_INTERVAL=2s
# How often the scheduler wakes to check and queue due auto crawls.
# Schedules are minute-granular, so keep this at 1m to hit them on time.
AUTO_CRAWL_SCHEDULER_INTERVAL=1m

## AI Audit Worker
AI_AUDIT_WORKER_CONCURRENCY=2
AI_AUDIT_WORKER_POLL_INTERVAL=2s

# AI Providers
OPENROUTER_API_KEY=
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Per-turn timeout for the AI chat agent (range 30s-10m, default 5m).
AI_TURN_TIMEOUT=5m

# Renderer / Obscura
OBSCURA_PATH=obscura
RENDERER_CONCURRENCY=2
OBSCURA_TIMEOUT_SECONDS=5
OBSCURA_KILL_TIMEOUT_SECONDS=7

# Google Stuff
## Search Console / OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
GOOGLE_TOKEN_ENCRYPTION_SECRET=replace-this-with-a-long-random-secret

## PageSpeed Insights
PAGESPEED_API_KEY=
